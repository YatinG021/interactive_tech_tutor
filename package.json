{
  "name": "interactive-tech-tutor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build": "npm --workspace apps/api run build && npm --prefix apps/frontend run build",
    "start:api": "npm --workspace apps/api run start",
    "backup:export": "npm --workspace apps/api run backup:export",
    "backup:import": "npm --workspace apps/api run backup:import --"
  }
}
