PORT=4000

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated exact origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:3000,https://<user>.github.io
ALLOWED_ORIGINS=
CORS_ORIGIN=

# Azure OpenAI (Microsoft Foundry)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=itt-llm
# Optional second deployment used when the primary is rate-limited (e.g. a gpt-5-mini deployment)
AZURE_OPENAI_OVERFLOW_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional tuning
# AZURE_OPENAI_TIMEOUT_MS=60000
# LLM_MAX_CONCURRENCY=6

# Sarvam AI natural voice for narration (optional; falls back to the browser voice)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=simran_en_edtech
# Characters sent to Sarvam per UTC day; cached clips are free
TTS_DAILY_CHAR_LIMIT=8000

# SQLite database (users, sessions, preferences, progress, history, simulation cache).
# In Azure this is the mounted Azure Files share, e.g. /data
DATA_DIR=./data

# Bump to invalidate every cached simulation; cached results live for SIMULATION_CACHE_TTL_HOURS
CACHE_VERSION=3
# SIMULATION_CACHE_TTL_HOURS=168

# Commit SHA reported by /health (set by CI)
# DEPLOYED_COMMIT=

# Legacy, unused
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
