,"delay":1800,"direction":"none"}},{"type":"highlight_box","x":38,"y":68,"width":24,"height":19,"color":"#ff6b35","label_position":"above","animation":{"type":"pulse","duration":1000,"delay":2600,"direction":"none"},"label":""},{"type":"text","x":10,"y":10,"width":80,"height":10,"color":"#64748b","label":"Sum of Exponentials","label_position":"above","animation":{"type":"fade_in","duration":600,"delay":0,"direction":"none"}}]}},{"step":4,"concept":"Divide to Normalize","subtitle":"Next, we divide each exponentiated value by the sum to get probabilities. For example, 7.39 divided by 11.11 is about 0.665. This step ensures all probabilities add up to 1. It converts raw scores into a meaningful distribution.","duration_ms":15200,"canvas_instructions":{"elements":[{"type":"rectangle","x":10,"y":30,"width":18,"height":12,"color":"#00d4ff","label":"e2  7.39","label_position":"above","animation":{"type":"fade_in","duration":800,"delay":0,"direction":"none"}},{"type":"rectangle","x":40,"y":30,"width":18,"height":12,"color":"#00d4ff","label":"e1  2.72","label_position":"above","animation":{"type":"fade_in","duration":800,"delay":200,"direction":"none"}},{"type":"rectangle","x":70,"y":30,"width":18,"height":12,"color":"#00d4ff","label":"e0  1","label_position":"above","animation":{"type":"fade_in","duration":800,"delay":400,"direction":"none"}},{"type":"text","x":20,"y":20,"width":15,"height":6,"color":"#64748b","label":"Divide by sum 11.11","label_position":"above","animation":{"type":"fade_in","duration":700,"delay":600,"direction":"none"}},{"type":"rectangle","x":10,"y":65,"width":18,"height":12,"color":"#ff6b35","label":"0.665","label_position":"above","animation":{"type":"fade_in","duration":800,"delay":1400,"direction":"none"}},{"type":"rectangle","x":40,"y":65,"width":18,"height":12,"color":"#8b5cf6","label":"0.245","label_position":"above","animation":{"type":"fade_in","duration":800,"delay":1600,"direction":"none"}},{"type":"rectangle","x":70,"y":65,"width":18,"heigh